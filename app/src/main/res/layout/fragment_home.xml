<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F8FC">

    <!-- HEADER -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Deteksi Bawang"
        android:textSize="22sp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:padding="18dp"
        android:background="#0D1B2A"
        android:textColor="#FFFFFF"
        android:elevation="8dp"/>

    <!-- CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- LABEL DI ATAS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilih Sumber Gambar"
                android:textSize="14sp"
                android:textColor="#415A77"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="10dp"/>

            <!-- BUTTON PICKER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCamera"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="Kamera"
                    android:textAllCaps="false"
                    app:cornerRadius="16dp"
                    app:strokeColor="#0D1B2A"
                    app:icon="@android:drawable/ic_menu_camera"
                    app:iconTint="#0D1B2A"
                    android:textColor="#0D1B2A"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGallery"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Galeri"
                    android:textAllCaps="false"
                    app:cornerRadius="16dp"
                    app:strokeColor="#0D1B2A"
                    app:icon="@android:drawable/ic_menu_gallery"
                    app:iconTint="#0D1B2A"
                    android:textColor="#0D1B2A"/>
            </LinearLayout>

            <!-- PREVIEW CARD (AWALNYA HIDDEN) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPreview"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:strokeWidth="2dp"
                app:strokeColor="#1B263B">

                <ImageView
                    android:id="@+id/imgPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"/>
            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnalisis"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="Analisis"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                app:cornerRadius="18dp"
                app:backgroundTint="#0D1B2A"
                android:textColor="#FFFFFF"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>